#!/bin/bash
set -euo pipefail

pids=()
stop_publishers() {
    if ((${#pids[@]})); then
        kill "${pids[@]}" 2>/dev/null || true
        wait "${pids[@]}" 2>/dev/null || true
        pids=()
    fi
}
trap stop_publishers EXIT
trap 'exit 0' TERM INT

addresses=
while true; do
    current=$(ip -j address show dev end0 | jq -r '
        [.[].addr_info[] | select(.scope == "global" or .scope == "link")
        | select(.tentative != true and .dadfailed != true)]
        | [group_by(.family)[]
            | (map(select(.scope == "global" and .deprecated != true))) as $global
            | (if $global | length > 0 then $global else . end)
            | .[].local]
        | sort | .[]')
    restart=no
    for pid in "${pids[@]}"; do
        if ! kill -0 "$pid" 2>/dev/null; then
            restart=yes
        fi
    done
    if [[ "$current" != "$addresses" || "$restart" == yes ]]; then
        stop_publishers
        addresses=$current
        while IFS= read -r address; do
            [[ -n "$address" ]] || continue
            avahi-publish-address --no-reverse --no-fail green-printer.local "$address" &
            pids+=("$!")
        done <<< "$addresses"
    fi
    sleep 2 &
    wait "$!"
done
